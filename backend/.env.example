# Django Settings
DJANGO_SECRET_KEY=your-super-secret-key-change-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL Database
POSTGRES_DB=personal_website
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Mapbox
# MAPBOX_ACCESS_TOKEN is set via Dokploy environment variables

# Internal proxy contract (shared secret between the Next.js proxy and this backend).
# When set, the chat and newsletter views trust the proxy-forwarded leftmost
# x-forwarded-for as the real client IP, and the chat view rejects requests that
# do not carry a matching x-internal-proxy-secret header. Leave UNSET to stay
# permissive (nothing breaks before the secret is deployed).
# INTERNAL_PROXY_SECRET=

# Chat abuse limits (Django cache based; defaults shown).
# CHAT_RATE_PER_MIN=10
# CHAT_DAILY_LIMIT=500
